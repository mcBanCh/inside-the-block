# copy to .env (never commit .env)
ITB_LIVE=0                 # 1 = really send (spend-capped)
ITB_MAX_SPEND_SOL=0.05     # hard ceiling in code is 0.05
ITB_RPC_URL=https://api.mainnet-beta.solana.com   # a private RPC (e.g. with ?api-key=) reduces 429s; key never logged
ITB_HORIZON_SLOTS=20000     # look-ahead; 3000 (~11 min) for a quick demo
ITB_BURSTS_PER_VALIDATOR=6  # arms cycle per validator; 6 = every default arm once
ITB_VALIDATORS_PER_CLIENT=2
ITB_SEED=                   # empty = random, recorded in meta.json
